mapscripts LittlerootTown_TestMapConnection_2_MapScripts {}

script TestMapConnection_2_DigSiteTest
{
    lockall
    msgbox("Lets start digging!")
    waitmessage
    fadescreen(FADE_TO_BLACK)
    startmininghere(0) //Macros do not like constants, for some reason. Ensure this number matches the appropriate location ID within mining_minigame.h
    releaseall
}