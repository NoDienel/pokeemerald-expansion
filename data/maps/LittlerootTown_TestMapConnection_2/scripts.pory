mapscripts LittlerootTown_TestMapConnection_2_MapScripts {}

script TestMapConnection_2_GiveDynamite
{
    lockall
    removeobject(1)
    playfanfare(MUS_OBTAIN_ITEM)
    giveitem(ITEM_MINING_DYNAMITE)
    waitmessage
    releaseall
}

script TestMapConnection_2_DigSiteTest
{
    lockall
    msgbox("Lets start digging!")
    waitmessage
    fadescreen(FADE_TO_BLACK)
    startmininghere(LOCATIONID_TEST_1)
    releaseall
}
